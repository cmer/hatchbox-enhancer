{
  "manifest_version": 3,
  "name": "Hatchbox Enhancer",
  "version": "1.0.0",
  "description": "Group your Hatchbox apps, nest staging under production, and sort them your way. Syncs through your browser account.",
  "homepage_url": "https://github.com/cmer/hatchbox-enhanced",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://hatchbox.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
